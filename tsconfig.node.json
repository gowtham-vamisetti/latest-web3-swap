{\n  "extends": "./tsconfig.json",\n  "compilerOptions": {\n    "target": "ESNext",\n    "module": "CommonJS",\n    "outDir": "./dist/node",\n    "rootDir": "./src",\n    "strict": true,\n    "esModuleInterop": true,\n    "skipLibCheck": true,\n    "forceConsistentCasingInFileNames": true\n  },\n  "include": ["src/**/*"],\n  "exclude": ["node_modules", "**/*.spec.ts"]\n}